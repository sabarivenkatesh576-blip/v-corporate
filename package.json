{
  "name": "v-corp",
  "version": "1.0.0",
  "description": "V-CORP — Virtual Corporate Experience, AI Skill Mapping & Career Readiness Platform (Smart India Hackathon)",
  "scripts": {
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:server": "npm --prefix server run build",
    "build:client": "npm --prefix client run build",
    "build": "npm run build:server && npm run build:client",
    "start": "npm --prefix server run start",
    "seed": "npm --prefix server run seed",
    "reset-demo": "npm --prefix server run seed",
    "test": "npm --prefix server run test"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
